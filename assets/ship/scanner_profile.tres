[resource]
script = ExtResource("1_profile")
range_px = 1100.0
sweep_seconds = 3.5
sweep_energy_cost = 12.0
max_contacts = 48
candidate_factor = 8
signatures = Array[ExtResource("2_signature")]([SubResource("Resource_poi_wreck_fragment"), SubResource("Resource_poi_hull_section"), SubResource("Resource_poi_ring_segment"), SubResource("Resource_poi_crystal"), SubResource("Resource_poi_signal_buoy"), SubResource("Resource_poi_alien_orb"), SubResource("Resource_poi_monolith"), SubResource("Resource_poi_husk"), SubResource("Resource_poi_story_beacon"), SubResource("Resource_poi_pelagia"), SubResource("Resource_poi_resonance_node"), SubResource("Resource_poi_source"), SubResource("Resource_poi_leviathan"), SubResource("Resource_asteroid"), SubResource("Resource_debris"), SubResource("Resource_derelict"), SubResource("Resource_structure"), SubResource("Resource_beacon"), SubResource("Resource_hazard"), SubResource("Resource_research"), SubResource("Resource_resonance"), SubResource("Resource_distress")])
title = "survey scanner"
