[gd_resource type="Resource" script_class="ResearchUpgradeProfile" format=3]

[ext_resource type="Script" path="res://scripts/research/research_upgrade_profile.gd" id="1_profile"]
[ext_resource type="Script" path="res://scripts/research/research_upgrade.gd" id="2_upgrade"]

; ------------------------------------------------------------------- scanner ---

[sub_resource type="Resource" id="R_scanner_range_1"]
script = ExtResource("2_upgrade")
upgrade_id = "scanner.range"
display_name = "Scanner: Detection Range"
description = "Increases the scanner's detection radius."
device_id = "scanner"
device_type = "ShipScanner"
attribute = "range_multiplier"
level = 1
max_level = 4
modifier_type = "multiply"
value = 1.25
cost_xp = 50

