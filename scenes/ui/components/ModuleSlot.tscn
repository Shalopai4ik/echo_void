[gd_scene format=3]

[node name="ModuleSlot" type="PanelContainer"]
custom_minimum_size = Vector2(112, 96)
layout_mode = 2

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 8
theme_override_constants/margin_top = 7
theme_override_constants/margin_right = 8
theme_override_constants/margin_bottom = 7

[node name="Content" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="Status" type="Label" parent="Margin/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.3, 0.82, 0.87, 1)
theme_override_font_sizes/font_size = 10
text = "● В СЕТИ"

[node name="Name" type="Label" parent="Margin/Content"]
layout_mode = 2
size_flags_vertical = 3
theme_override_font_sizes/font_size = 14
text = "СКАНЕР"
horizontal_alignment = 1
vertical_alignment = 1

[node name="Key" type="Label" parent="Margin/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.48, 0.68, 0.73, 1)
theme_override_font_sizes/font_size = 10
text = "[R]"
horizontal_alignment = 1
