class_name MissionStory

## The words of the demo, kept apart from the logic that plays them.
##
## Setting: the survey ship «Эхо» arrives at the gas giant Тифон to map its
## belt and to find what is left of the expedition «Пелагия», lost here three
## years ago. Two voices: ГЕЛИОС-7 (the station, far away, on a delay) and
## ЛАНСКАЯ (the science officer on board). The lost crew speaks through their
## beacons and logs. Nobody explains the creature; the pilot pieces it together.

const CONTROL := "ГЕЛИОС-7"
const SCIENCE := "ЛАНСКАЯ"
const PELAGIA := "«ПЕЛАГИЯ», ЖУРНАЛ"
const HINT := "ПОДСКАЗКА"

## The direction of the giant and the lateral one, used to lay out the route.
const D := Vector2(0.6, -0.8)
const L := Vector2(0.8, 0.6)

const CHAPTERS := [
	{"id": "arrival", "title": "ГЛАВА 1 · ПРИБЫТИЕ", "aggression": 0, "atmosphere": 0, "scale": 0.0},
	{"id": "trail", "title": "ГЛАВА 2 · СЛЕД «ПЕЛАГИИ»", "aggression": 1, "atmosphere": 1, "scale": 0.6},
	{"id": "presence", "title": "ГЛАВА 3 · ПРИСУТСТВИЕ", "aggression": 3, "atmosphere": 2, "scale": 0.85},
	{"id": "depth", "title": "ГЛАВА 4 · ГЛУБИНА", "aggression": 3, "atmosphere": 3, "scale": 1.0},
	{"id": "source", "title": "ГЛАВА 5 · ИСТОЧНИК", "aggression": 3, "atmosphere": 4, "scale": 1.0},
]

static func route() -> Dictionary:
	return {
		"tutorial_wreck": Vector2(760, 460),
		"tutorial_crystal": Vector2(-1000, -650),
		"beacon_1": D * 5500.0 + L * 1500.0,
		"beacon_2": D * 10500.0 - L * 2000.0,
		"beacon_3": D * 15500.0 + L * 1800.0,
		"pelagia": D * 21000.0 - L * 1200.0,
		"node_1": D * 25500.0 + L * 3200.0,
		"node_2": D * 27500.0 - L * 2600.0,
		"node_3": D * 30500.0 + L * 500.0,
		"source": D * 35000.0,
		"extraction": D * 28000.0 + L * 4000.0,
	}

const INTRO := [
	[CONTROL, "«Эхо», это «Гелиос-7». Вы на орбите Тифона. Задача: картография пояса и поиск следов экспедиции «Пелагия». Задержка связи - сорок секунд. Действуйте самостоятельно."],
	[HINT, "W/S - тяга и торможение, A/D - разворот, Q/E - боковые двигатели, Shift - форсаж, Пробел - экстренный тормоз."],
	[SCIENCE, "Приборы холодные. Включите сканер обзора - слот 1."],
]

const TUTORIAL_STEPS := {
	"scanner_on": [HINT, "Сканер включён. R - обход пространства. Обход тратит энергию и шумит."],
	"scanned": [SCIENCE, "Контакты есть. Включите исследовательский стол - слот 2."],
	"desk_on": [HINT, "N - панель исследований. Выберите объект и начните анализ, затем закройте панель. Держитесь рядом с объектом: стол работает в пределах 150 м."],
	"studied": [SCIENCE, "Первые данные. Research XP можно потратить на улучшения - панель U. Это не обязательно, но полезно."],
	"keys": [HINT, "I - оборудование корабля, C - экран сканера, N - исследования, U - улучшения, Esc - пауза и настройки звука."],
}

const TRAIL_START := [
	[SCIENCE, "Есть кое-что. Три аварийных маяка «Пелагии». Они выстроены цепочкой - к облакам."],
	[HINT, "Маркер на краю экрана ведёт к цели. Изучите маяк так же, как обломок: обход, затем анализ."],
]

const BEACON_LOGS := [
	[[PELAGIA, "День 41. Пояс пуст, как вычищенный. Ни одного свежего обломка. Командир говорит - так не бывает."],
		[SCIENCE, "Сорок первый день. Значит, они были здесь долго."]],
	[[PELAGIA, "День 58. Сканер ловит контакт, которого нет. Он появляется, когда мы шумим. Мы перестали шуметь."],
		[SCIENCE, "...Я тоже это видела. Вчера, на пределе дальности."]],
	[[PELAGIA, "День 63. Оно идёт на свет. Мы бросили сигнальный огонь и ушли в тень. Оно осталось у огня на два часа."],
		[SCIENCE, "Огни. У нас есть стойка с огнями - слот 4. И ложные цели - слот 3."]],
]

const PRESENCE_START := [
	[CONTROL, "«Эхо», ваши записи получены. Найдите корпус «Пелагии». Нам нужен её журнал."],
	[HINT, "Шум корабля - скорость, форсаж, обход, анализ - привлекает внимание. Индикатор активности - справа сверху."],
	[HINT, "Ложная цель [3] уводит малые биосигнатуры: они идут на неё и гибнут. Сигнальный огонь [4] привлекает крупную массу - бросьте его и уходите. Свет огня отпугивает малых."],
]

const PELAGIA_FOUND := [
	[SCIENCE, "Это она. Внешне цела. Начинайте анализ - шестьдесят секунд, и не отходите далеко."],
]

const PELAGIA_LOGS := [
	[PELAGIA, "Последняя запись. Оно не охотится. Оно слушает. Мы для него - шум в комнате, где кто-то спит."],
	[PELAGIA, "Сигнал идёт из облаков, через три узла. Узлы - как уши. Командир повёл корабль к Источнику."],
	[SCIENCE, "Они пошли глубже. Узлы есть на карте. Простите, «Гелиос», мы пойдём за ними."],
]

const DEPTH_START := [
	[CONTROL, "«Эхо», подтверждаем. Изучите резонансные узлы. Будьте осторожны - на Тифоне меняется рисунок облаков."],
]

const NODE_LOGS := [
	[[SCIENCE, "Узел передаёт ритм. Сорок одна секунда. Это... пульс."]],
	[[SCIENCE, "Второй узел. Ритм ускорился, когда мы начали анализ. Оно знает, что мы здесь."]],
	[[SCIENCE, "Третий. Все три сходятся в одной точке над облаками. Там Источник."],
		[CONTROL, "«Эхо», передайте данные и уходите. Это приказ."],
		[SCIENCE, "Ещё одно измерение. Ради «Пелагии»."]],
]

const SOURCE_FOUND := [
	[SCIENCE, "Кольцо. Оно больше, чем корабль-матка. Анализ - девяносто секунд. Если оно проснётся - огни, ложные цели, и держитесь в пределах дальности."],
]

const SOURCE_MID := [
	[SCIENCE, "Масса под нами растёт. Это не существо возле планеты. Это существо в планете."],
]

const SOURCE_DONE := [
	[SCIENCE, "Готово! Всё записано. Уходим - точка эвакуации на карте. Полный ход!"],
	[CONTROL, "«Эхо», вас понял, коридор открыт. Не оглядывайтесь."],
]

const ENDING_TITLE := "ДЕМОВЕРСИЯ ЗАВЕРШЕНА"
const ENDING_TEXT := "«Эхо» вышло из пояса и передало данные на «Гелиос-7». Через сорок одну секунду после передачи станция перестала отвечать.\n\nНа последнем снимке Тифона облака сложились в кольцо. Источник был не дверью. Он был глазом - и теперь он открыт.\n\nПродолжение следует."
const DEATH_TITLE := "СВЯЗЬ ПОТЕРЯНА"
const DEATH_TEXT := "Последний пакет телеметрии «Эха» пришёл на «Гелиос-7» с задержкой в сорок секунд. Он был пуст.\n\nПопробуйте снова: тише, медленнее, ближе к свету."
